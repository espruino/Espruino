/* Flash region for the RP2350 Espruino build.
 *
 * The Pico SDK's memmap_default.ld does `INCLUDE "pico_flash_region.ld"` to
 * pull in the FLASH MEMORY entry (normally generated by its CMake build). We
 * provide it here and add targets/rp2350 to the linker search path (-L) so the
 * SDK linker script can be used unmodified.
 *
 * FLASH length is limited to the firmware region so linked code cannot spill
 * into the area Espruino uses for saved code (see 'saved_code' in the board
 * file, and FLASH_SAVED_CODE_START).
 */
FLASH(rx) : ORIGIN = 0x10000000, LENGTH = 1024k
