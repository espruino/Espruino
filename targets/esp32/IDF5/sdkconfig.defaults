# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.3 Project Minimal Configuration
#
# cd bin
# idf.py menuconfig
## create list of changes
# idf.py save-defconfig
#
## and save the common parts in sdkconfig.defaults

CONFIG_BT_ENABLED=y
CONFIG_ESP_INT_WDT=n
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_RMT_SUPPRESS_DEPRECATE_WARN=y

# IPv6 disabled for now as we don't support IPv6 DNS yet
CONFIG_LWIP_IPV6=n
#CONFIG_LWIP_IPV6=y
#CONFIG_LWIP_IPV6_AUTOCONFIG=y

CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_TASK_WDT=n
CONFIG_BOOTLOADER_WDT_ENABLE=n
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192

CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5744
CONFIG_LWIP_TCP_WND_DEFAULT=5744

# disable logs
CONFIG_LOG_COLORS=n
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=n
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL=0
CONFIG_LOG_BOOTLOADER_LEVEL_INFO=n
CONFIG_LOG_BOOTLOADER_LEVEL=2
CONFIG_BT_LOG_HCI_TRACE_LEVEL_WARNING=n
CONFIG_BT_LOG_BLUEDROID_TRACE_LEVEL=0
CONFIG_LOG_DEFAULT_LEVEL_INFO=n
CONFIG_LOG_DEFAULT_LEVEL=2
CONFIG_LOG_MAXIMUM_LEVEL=2

# Ensure no classic bluetooth
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_CLASSIC_ENABLED=n

# Bluetooth sleep
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_INT_RC=y
CONFIG_BT_CTRL_SLEEP_MODE_EFF=1
CONFIG_BT_CTRL_SLEEP_CLOCK_EFF=1
CONFIG_BT_BLUEDROID_MEM_DEBUG=n


# Bluetooth Memory
# Limit default GATT MTU size (Default: 512)
# Setting this caps maximum allocated ATT packet buffers
CONFIG_BT_GATT_MAX_SR_ATT_DB_SIZE=128
CONFIG_BLE_MESH=n
CONFIG_BT_ACL_CONNECTIONS=2
CONFIG_BT_MULTI_CONNECTION_ENBALE=n # typo?
CONFIG_BT_MULTI_CONNECTION_ENABLE=n
# WiFi memory
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=8

CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=8
# AMPDU not needed as it's just for high speed
CONFIG_ESP32_WIFI_AMPDU_TX_ENABLED=n

# Enable Enterprise authentication features if standard WPA2/WPA3 Home is used
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=y
# Enable WPA3 SAE
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
# Change static RX buffers to dynamic (freed when idle)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=0
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16  # (Default is often 32)
# Reduce TX buffers
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# Reduce RX Management buffers
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
# Move Wi-Fi code out of IRAM and execute from Flash (saves ~10–20 KB RAM)
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# Move LWIP (TCP/IP stack) functions into Flash
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
